# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# 쿠팡 API 호출 속도 제한 가드 로컬 상태 (환경마다 별개로 관리)
.coupang-rate-limit.json

# 매장 가격표 매칭 진행상황/리포트 (재실행하면 다시 만들어짐)
data/.match-progress.json
/match-report.json

# typescript
*.tsbuildinfo
next-env.d.ts
